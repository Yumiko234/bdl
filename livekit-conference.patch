index 0000000..dd42643
--- /dev/null
+++ b/src/components/conference/LiveKitCall.tsx
@@ -0,0 +1,259 @@
+import { useEffect, useRef, useState, useCallback } from "react";
+import {
+  LiveKitRoom,
+  VideoConference,
+  StartAudio,
+  RoomAudioRenderer,
+  useLocalParticipant,
+  useParticipants,
+} from "@livekit/components-react";
+import "@livekit/components-styles";
+import { Button } from "@/components/ui/button";
+import { supabase } from "@/integrations/supabase/client";
+import { toast } from "sonner";
+import { Hand, Loader2, LogOut, PhoneOff, UserCheck, AlertCircle } from "lucide-react";
+
+interface LiveKitCallProps {
+  conferenceId: string;
+  title: string;
+  /** Prénom saisi par un invité (non connecté). */
+  guestName?: string;
+  /** L'utilisateur quitte seul (la conférence continue). */
+  onLeave: () => void;
+  /** La conférence est terminée pour tout le monde. */
+  onEnded: () => void;
+}
+
+interface TokenResponse {
+  token: string;
+  url: string;
+  role: "moderator" | "audience";
+  identity: string;
+  name: string;
+}
+
+async function callFn<T = any>(body: Record<string, unknown>): Promise<T> {
+  const { data, error } = await supabase.functions.invoke("livekit-token", { body });
+  if (error) {
+    // Le corps JSON de l'erreur contient le vrai message renvoyé par la fonction
+    let msg = error.message;
+    try {
+      const ctx = (error as any).context;
+      if (ctx?.json) msg = (await ctx.json())?.error ?? msg;
+    } catch { /* garde le message par défaut */ }
+    throw new Error(msg);
+  }
+  if ((data as any)?.error) throw new Error((data as any).error);
+  return data as T;
+}
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Panneau « mains levées » + bouton lever la main
+// ─────────────────────────────────────────────────────────────────────────────
+
+function HandsPanel({ conferenceId, isModerator }: { conferenceId: string; isModerator: boolean }) {
+  const { localParticipant } = useLocalParticipant();
+  const participants = useParticipants();
+  const [promoting, setPromoting] = useState<string | null>(null);
+
+  const myRole = localParticipant.attributes?.role;
+  const handUp = localParticipant.attributes?.hand === "1";
+  const canSpeak = localParticipant.permissions?.canPublish ?? false;
+
+  const toggleHand = async () => {
+    try {
+      await localParticipant.setAttributes({ hand: handUp ? "" : "1" });
+    } catch {
+      toast.error("Impossible de lever la main.");
+    }
+  };
+
+  const promote = async (identity: string) => {
+    setPromoting(identity);
+    try {
+      await callFn({ action: "promote", conferenceId, identity });
+      toast.success("Parole accordée.");
+    } catch (e: any) {
+      toast.error(e.message ?? "Échec");
+    } finally {
+      setPromoting(null);
+    }
+  };
+
+  const raised = participants.filter(
+    (p) => !p.isLocal && p.attributes?.hand === "1",
+  );
+
+  return (
+    <div className="absolute top-3 left-3 z-10 flex flex-col gap-2 max-w-[280px]">
+      {!canSpeak && myRole !== "moderator" && (
+        <Button
+          size="sm"
+          variant={handUp ? "default" : "secondary"}
+          onClick={toggleHand}
+          className="gap-1.5 shadow"
+        >
+          <Hand className="h-4 w-4" />
+          {handUp ? "Baisser la main" : "Demander la parole"}
+        </Button>
+      )}
+
+      {isModerator && raised.length > 0 && (
+        <div className="rounded-xl bg-background/95 text-foreground shadow-lg border p-3 space-y-2">
+          <p className="text-xs font-semibold flex items-center gap-1.5">
+            <Hand className="h-3.5 w-3.5 text-amber-500" />
+            Mains levées ({raised.length})
+          </p>
+          {raised.map((p) => (
+            <div key={p.identity} className="flex items-center justify-between gap-2">
+              <span className="text-sm truncate">{p.name || p.identity}</span>
+              <Button
+                size="sm"
+                variant="outline"
+                className="h-7 px-2 text-xs gap-1"
+                disabled={promoting === p.identity}
+                onClick={() => promote(p.identity)}
+              >
+                {promoting === p.identity
+                  ? <Loader2 className="h-3 w-3 animate-spin" />
+                  : <UserCheck className="h-3 w-3" />}
+                Donner la parole
+              </Button>
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Composant principal
+// ─────────────────────────────────────────────────────────────────────────────
+
+export default function LiveKitCall({
+  conferenceId, title, guestName, onLeave, onEnded,
+}: LiveKitCallProps) {
+  const [conn, setConn] = useState<TokenResponse | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [ending, setEnding] = useState(false);
+
+  // Callbacks gardés dans des refs : le parent en recrée de nouveaux à chaque rendu,
+  // ce qui redémarrerait sans cesse le minuteur de vérification ci-dessous.
+  const onLeaveRef = useRef(onLeave);
+  const onEndedRef = useRef(onEnded);
+  useEffect(() => { onLeaveRef.current = onLeave; onEndedRef.current = onEnded; });
+
+  // 1) Récupère le jeton auprès de l'Edge Function
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      try {
+        const res = await callFn<TokenResponse>({
+          action: "token", conferenceId, guestName,
+        });
+        if (!cancelled) setConn(res);
+      } catch (e: any) {
+        if (!cancelled) setError(e.message ?? "Connexion impossible.");
+      }
+    })();
+    return () => { cancelled = true; };
+  }, [conferenceId, guestName]);
+
+  // 2) Si l'hôte termine la conférence, tout le monde est déconnecté
+  useEffect(() => {
+    const t = setInterval(async () => {
+      const { data } = await supabase
+        .from("conferences").select("status").eq("id", conferenceId).maybeSingle();
+      if (data && (data as any).status === "ended") {
+        toast.info("La conférence est terminée.");
+        onEndedRef.current();
+      }
+    }, 5000);
+    return () => clearInterval(t);
+  }, [conferenceId]);
+
+  const endForAll = useCallback(async () => {
+    if (!window.confirm("Terminer la conférence pour tous les participants ?")) return;
+    setEnding(true);
+    try {
+      await callFn({ action: "end", conferenceId });
+      onEndedRef.current();
+    } catch (e: any) {
+      toast.error(e.message ?? "Impossible de terminer la conférence.");
+      setEnding(false);
+    }
+  }, [conferenceId]);
+
+  const isModerator = conn?.role === "moderator";
+
+  return (
+    <div className="fixed inset-0 z-50 bg-black flex flex-col" data-lk-theme="default">
+      {/* Barre du haut */}
+      <div className="flex items-center justify-between gap-3 px-4 py-2 bg-neutral-900 text-white">
+        <div className="min-w-0">
+          <p className="text-sm font-semibold truncate">{title}</p>
+          <p className="text-xs text-neutral-400">
+            {isModerator ? "Modérateur" : "Participant"}
+          </p>
+        </div>
+        <div className="flex items-center gap-2 shrink-0">
+          {isModerator && (
+            <Button size="sm" variant="destructive" onClick={endForAll} disabled={ending} className="gap-1.5">
+              {ending ? <Loader2 className="h-4 w-4 animate-spin" /> : <PhoneOff className="h-4 w-4" />}
+              <span className="hidden sm:inline">Terminer pour tous</span>
+            </Button>
+          )}
+          <Button size="sm" variant="secondary" onClick={() => onLeaveRef.current()} className="gap-1.5">
+            <LogOut className="h-4 w-4" />
+            <span className="hidden sm:inline">Quitter</span>
+          </Button>
+        </div>
+      </div>
+
+      {/* Corps */}
+      <div className="relative flex-1 min-h-0">
+        {error && (
+          <div className="absolute inset-0 flex flex-col items-center justify-center gap-3 text-white p-6 text-center">
+            <AlertCircle className="h-8 w-8 text-red-400" />
+            <p className="text-sm max-w-sm">{error}</p>
+            <Button variant="secondary" onClick={() => onLeaveRef.current()}>Retour</Button>
+          </div>
+        )}
+
+        {!error && !conn && (
+          <div className="absolute inset-0 flex items-center justify-center text-white gap-2">
+            <Loader2 className="h-5 w-5 animate-spin" /> Connexion à la conférence…
+          </div>
+        )}
+
+        {conn && (
+          <LiveKitRoom
+            token={conn.token}
+            serverUrl={conn.url}
+            connect
+            // Les modérateurs démarrent avec le micro ; les auditeurs écoutent.
+            audio={isModerator}
+            video={false}
+            options={{ adaptiveStream: true, dynacast: true }}
+            onDisconnected={() => onLeaveRef.current()}
+            onError={(e) => {
+              console.error("LiveKit:", e);
+              toast.error("Erreur de connexion : " + e.message);
+            }}
+            style={{ height: "100%" }}
+          >
+            <VideoConference />
+            <HandsPanel conferenceId={conferenceId} isModerator={isModerator} />
+            <RoomAudioRenderer />
+            {/* Safari / iOS / Android bloquent le son tant qu'on n'a pas touché l'écran */}
+            <StartAudio
+              label="Appuyer pour activer le son"
+              className="absolute bottom-24 left-1/2 -translate-x-1/2 z-20 rounded-full bg-primary text-primary-foreground px-4 py-2 text-sm shadow-lg"
+            />
+          </LiveKitRoom>
+        )}
+      </div>
+    </div>
+  );
+}
